#!/bin/sh
TMP_DIR=${TMP_DIR:-/tmp}

die() {
   echo
   for msg; do
      echo $msg
   done
   exit 1
}

# ###########################################################################
# Sanity check the cmd line options.
# ###########################################################################
if [ $# -lt 1 ]; then
   die "Usage: load-test-dbs PORT [DATABASE]"
fi

PORT=$1
DB=${2:-"pt_test_b"}

if [ ! -d "${TMP_DIR}/$PORT" ]; then
   die "PostgreSQL test server does not exist: ${TMP_DIR}/$PORT"
fi

PGOPTIONS="-c client_min_messages=warning" ${TMP_DIR}/$PORT/use -q -c "DROP DATABASE IF EXISTS $DB" || exit 1
${TMP_DIR}/$PORT/use -q -c "CREATE DATABASE $DB"         || exit 1

${TMP_DIR}/$PORT/use -v ON_ERROR_STOP=1 -q -d $DB >/dev/null <<SQL || exit 1
CREATE TABLE t1 (
   id         SERIAL PRIMARY KEY,
   name       TEXT NOT NULL,
   created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE t2 (
   id     SERIAL PRIMARY KEY,
   t1_id  INT NOT NULL REFERENCES t1 (id),
   amount NUMERIC(10,2) NOT NULL
);

CREATE INDEX t2_t1_id_idx ON t2 (t1_id);

INSERT INTO t1 (name) SELECT 'row ' || i FROM generate_series(1, 100) AS i;
INSERT INTO t2 (t1_id, amount) SELECT id, id * 1.5 FROM t1;

ANALYZE;
SQL

exit $?
