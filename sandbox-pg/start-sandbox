#!/bin/bash
TMP_DIR=${TMP_DIR:-/tmp}

# This script starts a PostgreSQL sandbox server for the Percona Toolkit
# tests.  sandbox-pg/test-env uses it.  The actual startup is done by
# ${TMP_DIR}/PORT/start, which this script calls after doing a bunch of
# sanity checks.
#
# Exit 0 if the sandbox server started ok, else 1 and debug_sandbox() is
# called to print some info to STDERR about what state the sandbox server
# might have been in.

die() {
    echo "$1" >&2
    exit 1
}

debug_sandbox() {
    local port="$1"
    ps x | grep postgres >&2
    if [ -d "${TMP_DIR}/$port" ]; then
        ls -lh ${TMP_DIR}/$port >&2
        [ -f "${TMP_DIR}/$port/data/postgres.log" ] && tail -n 100 ${TMP_DIR}/$port/data/postgres.log >&2
        [ -f "${TMP_DIR}/$port/data/pg.log" ] && tail -n 100 ${TMP_DIR}/$port/data/pg.log >&2
    else
        echo "${TMP_DIR}/$port does not exist" >&2
    fi
}

make_sandbox() {
    rm -rf ${TMP_DIR}/$port || die "Failed to rm ${TMP_DIR}/$port"
    mkdir -p ${TMP_DIR}/$port || die "Failed to mkdir ${TMP_DIR}/$port"

    $PT_PG_SANDBOX_BASEDIR/bin/initdb -D ${TMP_DIR}/$port/data -U postgres -A trust -E UTF8 --no-sync \
        >${TMP_DIR}/$port/initdb.log 2>&1
    if [ $? -ne 0 ]; then
        cat ${TMP_DIR}/$port/initdb.log >&2
        die "initdb failed for ${TMP_DIR}/$port/data"
    fi

    cp $server_dir/postgresql.conf ${TMP_DIR}/$port/data/postgresql.sandbox.conf
    cp $server_dir/pg_hba.conf ${TMP_DIR}/$port/data/pg_hba.conf
    echo "include 'postgresql.sandbox.conf'" >> ${TMP_DIR}/$port/data/postgresql.conf

    for script in start stop use; do
        cp $PERCONA_TOOLKIT_BRANCH/sandbox-pg/servers/$script ${TMP_DIR}/$port/$script
    done

    for file in ${TMP_DIR}/$port/start ${TMP_DIR}/$port/stop ${TMP_DIR}/$port/use \
                ${TMP_DIR}/$port/data/postgresql.sandbox.conf; do
        sed -e "s/PORT/$port/g" -i.bak $file
        # Use ! instead of / because the replacement has / (it's a directory)
        sed -e "s!TMP_DIR!$TMP_DIR!g" -i.bak $file
        sed -e "s!PT_PG_SANDBOX_BASEDIR!$PT_PG_SANDBOX_BASEDIR!g" -i.bak $file
    done
    rm ${TMP_DIR}/$port/*.bak ${TMP_DIR}/$port/data/*.bak >/dev/null 2>&1
    chmod +x ${TMP_DIR}/$port/start ${TMP_DIR}/$port/stop ${TMP_DIR}/$port/use

    ${TMP_DIR}/$port/start
    if [ $? -ne 0 ]; then
        echo "Sandbox $type $port failed to start." >&2
        debug_sandbox $port
        exit 1
    fi

    ${TMP_DIR}/$port/use -v ON_ERROR_STOP=1 -q >/dev/null <<SQL
ALTER USER postgres PASSWORD 'root';
CREATE ROLE $REPL_USER WITH REPLICATION LOGIN PASSWORD '$REPL_PASSWORD';
CREATE SCHEMA percona_test;
CREATE TABLE percona_test.sentinel (id INT PRIMARY KEY, ping TEXT NOT NULL DEFAULT '');
SQL
    if [ $? -ne 0 ]; then
        echo "Failed to configure sandbox $type $port." >&2
        debug_sandbox $port
        exit 1
    fi

    return 0
}

# ###########################################################################
# Sanity check the cmd line options.
# ###########################################################################
if [ $# -lt 2 ]; then
    die "Usage: start-sandbox source port"
fi

type=$1  # source
port=$2  # sandbox port number, e.g. 15432

REPL_USER=${REPL_USER:-"repl"}
REPL_PASSWORD=${REPL_PASSWORD:-"repl"}

if [ "$type" != "source" ]; then
    die "Invalid sandbox type: $type.  The only valid type is source."
fi

case "$port" in
    ''|*[!0-9]*) die "Invalid port: $port.  Ports must be numeric." ;;
esac

if [ $port -le 1024 ]; then
    die "Invalid port: $port.  Ports must be > 1024."
fi

# PostgreSQL puts its Unix socket in ${TMP_DIR}/PORT, and the kernel limits
# the socket path to 107 bytes, so check it here instead of letting the
# server fail with an obscure error.
socket_path="${TMP_DIR}/$port/.s.PGSQL.$port"
if [ ${#socket_path} -gt 107 ]; then
    die "Unix socket path is ${#socket_path} bytes, the limit is 107: $socket_path.  Use a shorter TMP_DIR."
fi

# ###########################################################################
# Sanity check the environment.
# ###########################################################################
if [ -z "$PERCONA_TOOLKIT_BRANCH" ]; then
    die "PERCONA_TOOLKIT_BRANCH environment variable is not set."
fi

if [ ! -d "$PERCONA_TOOLKIT_BRANCH" ]; then
    die "Invalid PERCONA_TOOLKIT_BRANCH directory: $PERCONA_TOOLKIT_BRANCH"
fi

# This script is usually called by test-env.  PT_PG_SANDBOX_BASEDIR points to
# a PostgreSQL installation prefix containing the executables as
# PT_PG_SANDBOX_BASEDIR/bin/postgres, etc.  There is no autodetection: the
# caller decides which PostgreSQL to run.
if [ -z "$PT_PG_SANDBOX_BASEDIR" ]; then
    die "PT_PG_SANDBOX_BASEDIR environment variable is not set."
fi

if [ ! -d "$PT_PG_SANDBOX_BASEDIR" ]; then
    die "Invalid PT_PG_SANDBOX_BASEDIR directory: $PT_PG_SANDBOX_BASEDIR"
fi

for bin in initdb pg_ctl postgres psql pg_isready; do
    if [ ! -x "$PT_PG_SANDBOX_BASEDIR/bin/$bin" ]; then
        die "Cannot find executable $bin in $PT_PG_SANDBOX_BASEDIR/bin."
    fi
done

# ###########################################################################
# Get server version.
# ###########################################################################
version=`$PT_PG_SANDBOX_BASEDIR/bin/postgres --version 2>/dev/null | awk '{print $3}'`
major=${version%%.*}

case "$major" in
    ''|*[!0-9]*) die "Cannot parse the version reported by $PT_PG_SANDBOX_BASEDIR/bin/postgres --version: $version" ;;
esac

if [ $major -lt 10 ]; then
    major=`echo $version | cut -d. -f1,2`
fi

server_dir="$PERCONA_TOOLKIT_BRANCH/sandbox-pg/servers/$major"
if [ ! -d "$server_dir" ]; then
    die "$server_dir does not exist.  PostgreSQL $major is not supported by the sandbox yet."
fi

# ###########################################################################
# Start and configure the sandbox server.
# ###########################################################################
PIDFILE="${TMP_DIR}/$port/data/postmaster.pid"

if [ -f $PIDFILE ]; then
    echo "Sandbox $port already started (found pid file $PIDFILE)"
else
    make_sandbox
fi

exit $?
